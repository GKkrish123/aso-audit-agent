# =============================================================================
# ASO Audit Agent - Environment Configuration
# Copy this file to `.env.local` for local development.
# =============================================================================

# -----------------------------------------------------------------------------
# Model provider (pluggable - Mastra resolves "provider/model" strings)
# Examples (must be a model id Mastra's provider registry recognizes):
#   PRIMARY_MODEL=openai/gpt-5.1
#   PRIMARY_MODEL=openai/gpt-5-mini
#   PRIMARY_MODEL=openai/gpt-4o-mini
#   PRIMARY_MODEL=anthropic/claude-sonnet-4-6
#   PRIMARY_MODEL=google/gemini-2.5-flash
#   PRIMARY_MODEL=openrouter/anthropic/claude-haiku-4.5
# -----------------------------------------------------------------------------
PRIMARY_MODEL=openai/gpt-5.1

# Optional fallback chain - comma separated. First entry is tried first.
# Empty = no fallback. Useful for resilience to provider outages.
FALLBACK_MODELS=

# -----------------------------------------------------------------------------
# Provider API keys (set whichever providers you reference in PRIMARY/FALLBACK)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENROUTER_API_KEY=

# -----------------------------------------------------------------------------
# Custom OpenAI-compatible endpoint (e.g. NVIDIA NIM, LM Studio, vLLM).
# When CUSTOM_MODEL_URL is set, PRIMARY_MODEL is sent verbatim to that URL.
# Use whatever model id the upstream API expects (no `custom/` prefix needed).
#
# NVIDIA NIM examples:
#   CUSTOM_MODEL_URL=https://integrate.api.nvidia.com/v1
#   CUSTOM_MODEL_API_KEY=nvapi-...
#   PRIMARY_MODEL=openai/gpt-oss-20b
#   PRIMARY_MODEL=meta/llama-3.3-70b-instruct
#   PRIMARY_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
# -----------------------------------------------------------------------------
CUSTOM_MODEL_URL=
CUSTOM_MODEL_API_KEY=

# -----------------------------------------------------------------------------
# Mastra persistence (workflow snapshots, memory, traces)
# Defaults to a local SQLite file (file:./mastra.db) for dev.
#
# !! IMPORTANT FOR SERVERLESS (Vercel / Netlify / Cloudflare Workers) !!
# `file:` URLs MUST NOT be used on serverless platforms - the filesystem is
# read-only outside /tmp and /tmp is per-instance, so workflow snapshots
# silently get lost between invocations and audits will hang on
# "running_audit" forever.
#
# Use a libsql remote (Turso has a free tier):
#   MASTRA_DB_URL=libsql://<your-db>.turso.io
#   MASTRA_DB_AUTH_TOKEN=<turso-auth-token>
#
# /api/healthz will return ok:false and a warning if this is misconfigured.
# -----------------------------------------------------------------------------
MASTRA_DB_URL=file:./mastra.db
MASTRA_DB_AUTH_TOKEN=

# -----------------------------------------------------------------------------
# Optional scraping fallback (used when App Store HTML extraction degrades).
# Leave blank to disable; the app falls back gracefully.
# -----------------------------------------------------------------------------
FIRECRAWL_API_KEY=

# -----------------------------------------------------------------------------
# Rate limiting (in-memory). For multi-instance deploys, plug in Redis later.
# -----------------------------------------------------------------------------
RATE_LIMIT_RPM=30
RATE_LIMIT_BURST=10

# -----------------------------------------------------------------------------
# Runtime limits / budgets
# -----------------------------------------------------------------------------
METADATA_TIMEOUT_MS=10000
LISTING_TIMEOUT_MS=15000
AUDIT_MAX_DURATION_MS=120000
# Hard cap on a single agent.generate() call so a hung LLM provider can't
# eat the whole serverless function budget. Aborts cleanly and surfaces an
# actionable error in the job's `error` field. 90s leaves room inside both
# the Vercel Hobby (60s after-budget on the confirm route is the bottleneck
# - bump to a Pro plan or lower this on Hobby) and Pro (300s) limits.
LLM_TIMEOUT_MS=90000

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
LOG_LEVEL=info
NODE_ENV=development
